<style>.bar {flex-direction:row;gap:8px;padding:8px;background-color:#153A30;border-radius:12px;width:720px;}.control {height:48px;flex-grow:1;}</style><div class="bar"><Button id="begin" class="control"><ButtonLabel>Begin / Next</ButtonLabel></Button><Button id="pause" class="control"><ButtonLabel>Pause / Resume</ButtonLabel></Button><Button id="reset" class="control"><ButtonLabel>Reset</ButtonLabel></Button><Button id="center" class="control"><ButtonLabel>Recenter</ButtonLabel></Button><Button id="sound" class="control"><ButtonLabel>Sound</ButtonLabel></Button><Button id="exit" class="control"><ButtonLabel>Exit VR</ButtonLabel></Button></div>
